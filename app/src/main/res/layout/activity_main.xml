<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="28dp"
        android:paddingRight="48dp"
        android:paddingBottom="28dp">

        <!-- Заголовок и статус -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ByeDPI для Sony Bravia TV"
            android:textColor="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ОТКЛЮЧЕНО"
            android:textColor="#F8FAFC"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/proxyAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="127.0.0.1:1080"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Главная кнопка Вкл/Выкл -->
        <Button
            android:id="@+id/statusButton"
            android:layout_width="460dp"
            android:layout_height="68dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/tv_button_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="ВКЛЮЧИТЬ YOUTUBE"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold">
            <requestFocus />
        </Button>

        <!-- Выбор стратегии для Телецентра -->
        <Button
            android:id="@+id/presetButton"
            android:layout_width="460dp"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/tv_button_bg"
            android:focusable="true"
            android:text="Стратегия 1/5: Базовая (Split + OOB)"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/presetArgsText"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="-Ku -a1 -An -o1 -At,r,s -d1"
            android:textColor="#38BDF8"
            android:textSize="13sp" />

        <!-- Режим фильтрации приложений -->
        <Button
            android:id="@+id/ytOnlyButton"
            android:layout_width="460dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/tv_button_bg"
            android:focusable="true"
            android:text="Трафик: Только YouTube и SmartTube"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="17sp" />

        <!-- Автозапуск при включении ТВ -->
        <Button
            android:id="@+id/autostartButton"
            android:layout_width="460dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tv_button_bg"
            android:focusable="true"
            android:text="Автозапуск при включении ТВ: ВЫКЛ"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="17sp" />

        <!-- Кнопка перехода в полные настройки при необходимости -->
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="460dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tv_button_bg"
            android:focusable="true"
            android:text="Дополнительные настройки"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <!-- Подсказка на случай, если Sony вырезала окно VPN -->
        <TextView
            android:id="@+id/adbHintText"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FBBF24"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
