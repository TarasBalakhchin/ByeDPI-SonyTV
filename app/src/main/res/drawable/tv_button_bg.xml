<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Состояние, когда на кнопку наведен курсор с пульта -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263849" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Состояние нажатия -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0284C7" />
            <stroke android:width="3dp" android:color="#7DD3FC" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Обычное состояние -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
